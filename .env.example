# Copy this file to .env for local development. Never commit the real .env file.
NODE_ENV=development

# HTTP port is optional and defaults to 5000. Shutdown waits this many
# milliseconds for active responses before force-closing remaining sockets.
PORT=5000
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000

# PostgreSQL is the required source of truth. All five values must be provided.
DB_USER=devpulse
DB_HOST=localhost
DB_NAME=devpulse
DB_PASSWORD=replace_with_a_private_database_password
DB_PORT=5432

# Use a long, unpredictable value for JWT_SECRET in every deployed environment.
JWT_SECRET=replace_with_a_long_random_secret

# Tokens expire one hour after login unless this value is changed.
JWT_EXPIRES_IN=1h

# Comma-separated browser origins allowed to call the API. Never use * in
# production. The local React/Vite default is http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DevPulse accepts small JSON/form payloads, not file uploads.
REQUEST_BODY_LIMIT=100kb

# General API clients may make 100 requests per 15-minute window by default.
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100

# Login and registration share a stricter 10-attempt, 15-minute window.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Keep 0 for direct connections. Set the exact reverse-proxy hop count only
# when the deployment topology is known; never use unrestricted trust=true.
TRUST_PROXY_HOPS=0

# Redis is optional. When omitted, PostgreSQL serves every project read.
# Put credentials in your private .env value when the server requires them.
REDIS_URL=redis://localhost:6379

# Successful project reads remain cached for at least 60 seconds by default.
REDIS_PROJECT_TTL_SECONDS=60

# Add 0-10 seconds to each write so popular keys do not all expire together.
REDIS_PROJECT_TTL_JITTER_SECONDS=10

# Stop waiting on an unresponsive Redis command and fall back after 500 ms.
REDIS_OPERATION_TIMEOUT_MS=500
